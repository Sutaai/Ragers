{
  "configurations": [
    {
      "name": "Ragers - no args",
      "program": "${workspaceFolder}/target/debug/ragers",
      "request": "launch",
      "type": "lldb"
    },
    {
      "args": [
        "${input:cmd}",
        "${input:file}"
      ],
      "name": "Ragers - Interactive",
      "program": "${workspaceFolder}/target/debug/ragers",
      "request": "launch",
      "type": "lldb"
    }
  ],
  "inputs": [
    {
      "description": "Select the command to run",
      "id": "cmd",
      "options": [
        "encrypt",
        "decrypt",
        "edit"
      ],
      "type": "pickString"
    },
    {
      "default": "",
      "description": "File to pass to the command, if necessary",
      "id": "file",
      "type": "promptString"
    }
  ],
  "version": "0.2.0"
}
